.sparkline {
  position: relative;
  height: 180rpx;
  margin-top: 20rpx;
  border-radius: 22rpx;
  background:
    linear-gradient(180deg, rgba(83, 224, 255, 0.07), rgba(83, 224, 255, 0.01));
  overflow: hidden;
}

.sparkline::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.04) 1rpx, transparent 1rpx) 0 0 / 100% 25%,
    linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1rpx, transparent 1rpx) 0 0 / 12.5% 100%;
}

.spark-zero {
  position: absolute;
  left: 0;
  right: 0;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.14);
}

.spark-point {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  margin-left: -5rpx;
  margin-bottom: -5rpx;
  border-radius: 999rpx;
  box-shadow: 0 0 18rpx currentColor;
}

.spark-point.active {
  width: 16rpx;
  height: 16rpx;
  margin-left: -8rpx;
  margin-bottom: -8rpx;
}

.trend-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: 22rpx;
