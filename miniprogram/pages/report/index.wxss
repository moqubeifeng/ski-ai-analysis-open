}

.anomaly-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--rose);
}

.anomaly-subtitle {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-soft);
  line-height: 1.5;
}

.anomaly-item {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 28rpx;
  gap: 18rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.anomaly-item:last-child {
  border-bottom: none;
}

.anomaly-item.rose {
  background: rgba(255, 138, 138, 0.06);
}

.anomaly-item.amber {
  background: rgba(247, 198, 107, 0.05);
}

.anomaly-item-left {
  display: flex;
  align-items: center;
  padding-top: 8rpx;
}

.anomaly-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.anomaly-dot.rose {
  background: var(--rose);
  box-shadow: 0 0 10rpx var(--rose);
}

.anomaly-dot.amber {
  background: var(--amber);
  box-shadow: 0 0 10rpx var(--amber);
}

.anomaly-item-body {
  flex: 1;
}

.anomaly-item-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.anomaly-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.anomaly-tag {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.anomaly-tag.rose {
  background: rgba(255, 138, 138, 0.18);
  color: var(--rose);
}

.anomaly-tag.amber {
  background: rgba(247, 198, 107, 0.18);
  color: var(--amber);
}

.anomaly-conf {
  font-size: 20rpx;
  color: var(--text-soft);
  margin-left: auto;
}

.anomaly-time {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-soft);
  font-variant-numeric: tabular-nums;
}

.anomaly-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: var(--text-soft);
}
