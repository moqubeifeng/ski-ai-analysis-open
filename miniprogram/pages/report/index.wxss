/* ---- Download Button ---- */
.download-btn {
  display: block;
  width: 100%;
  margin-top: 24rpx;
  padding: 26rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.04em;
  background: linear-gradient(135deg, rgba(83, 224, 255, 0.18), rgba(124, 185, 255, 0.12));
  color: var(--text-main);
  border: 1.5rpx solid rgba(83, 224, 255, 0.30);
  text-align: center;
}

.download-btn.downloading,
.download-btn[disabled] {
  opacity: 0.52;
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(255, 255, 255, 0.10);
}

/* ---- Anomaly Alert Card ---- */
.anomaly-card {
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 100, 100, 0.07);
  border: 1.5rpx solid rgba(255, 138, 138, 0.30);
  overflow: hidden;
}

.anomaly-head {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx 20rpx;
  gap: 18rpx;
  border-bottom: 1rpx solid rgba(255, 138, 138, 0.14);
}

.anomaly-icon-wrap {
  font-size: 40rpx;
  line-height: 1;
  flex-shrink: 0;
}

.anomaly-head-text {
