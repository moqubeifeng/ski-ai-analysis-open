.hero-card {
  padding: 34rpx 30rpx 32rpx;
}

.hero-title {
  margin-top: 20rpx;
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-subtitle {
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text-soft);
}

.hero-metrics {
  display: flex;
  flex-wrap: wrap;
  margin-top: 32rpx;
  margin-right: -16rpx;
}

.hero-metric {
  width: calc(33.333% - 16rpx);
  margin-right: 16rpx;
  padding: 24rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(156, 214, 255, 0.08);
}

.hero-metric-value {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--sky-soft);
}

.hero-metric-label {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-soft);
}

.panel-card {
  padding: 30rpx;
}

.video-select {
  position: relative;
  margin-top: 26rpx;
  padding: 46rpx 24rpx;
  border-radius: 28rpx;
  border: 1rpx dashed rgba(83, 224, 255, 0.28);
  background:
    radial-gradient(circle at top, rgba(83, 224, 255, 0.12), transparent 58%),
    rgba(255, 255, 255, 0.03);
  text-align: center;
}

.video-select-ring {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 22rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(83, 224, 255, 0.32);
  box-shadow: inset 0 0 40rpx rgba(83, 224, 255, 0.16);
}

.video-select-title {
  font-size: 32rpx;
  font-weight: 600;
}

.video-select-hint {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-soft);
}

.video-meta-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 22rpx;
  margin-right: -16rpx;
}

.video-meta-item {
  width: calc(33.333% - 16rpx);
  margin-right: 16rpx;
  padding: 20rpx 18rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.04);
}

.video-meta-label {
  font-size: 22rpx;
  color: var(--text-dim);
}

.video-meta-value {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--text-main);
}

.panel-actions {
  margin-top: 22rpx;
}

.field-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
  margin-right: -18rpx;
}

.field-cell {
  width: calc(50% - 18rpx);
  margin-right: 18rpx;
  margin-bottom: 18rpx;
}

.field-cell:last-child {
  width: calc(100% - 18rpx);
}

.board-label {
  margin-top: 6rpx;
}

.segment-control {
  display: flex;
  margin-top: 18rpx;
  padding: 8rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.04);
}

.segment-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border-radius: 18rpx;
  color: var(--text-soft);
  font-size: 26rpx;
}

.segment-item.active {
  background: linear-gradient(135deg, rgba(83, 224, 255, 0.22), rgba(124, 185, 255, 0.18));
  color: var(--text-main);
  box-shadow: 0 10rpx 24rpx rgba(83, 224, 255, 0.14);
}

.switch-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 24rpx 24rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.04);
}

.switch-title {
  font-size: 30rpx;
  font-weight: 600;
}

.upload-progress {
  margin: 12rpx 0 24rpx;
}

.upload-progress-track {
  width: 100%;
  height: 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.upload-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--sky) 0%, #7cb9ff 100%);
}

.upload-progress-text {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--text-soft);
}

.flow-list {
  margin-top: 20rpx;
}

.flow-item {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
}

.flow-item + .flow-item {
  border-top: 1rpx solid rgba(156, 214, 255, 0.08);
}

.flow-step {
  width: 82rpx;
  height: 82rpx;
  margin-right: 20rpx;
  border-radius: 22rpx;
  background: rgba(83, 224, 255, 0.12);
  color: var(--sky-soft);
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.flow-title {
  font-size: 30rpx;
  font-weight: 600;
}

.flow-description {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-soft);
}
