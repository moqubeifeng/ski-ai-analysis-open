page {
  --bg-deep: #06111d;
  --bg-mid: #0b1c2d;
  --card: rgba(9, 27, 45, 0.88);
  --card-strong: rgba(12, 32, 52, 0.96);
  --stroke: rgba(156, 214, 255, 0.14);
  --text-main: #edf8ff;
  --text-soft: #9bb7ca;
  --text-dim: #69849a;
  --sky: #53e0ff;
  --sky-soft: #8de7ff;
  --emerald: #7cf5d1;
  --amber: #f7c66b;
  --rose: #ff8a8a;
  min-height: 100%;
  background:
    radial-gradient(circle at 18% 0%, rgba(83, 224, 255, 0.14), transparent 34%),
    radial-gradient(circle at 100% 0%, rgba(144, 167, 255, 0.16), transparent 28%),
    linear-gradient(180deg, #04101b 0%, #091628 46%, #06111d 100%);
  color: var(--text-main);
  font-family: "SF Pro Display", "PingFang SC", "Helvetica Neue", sans-serif;
}

view,
text,
button,
input,
switch,
video,
canvas,
image {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: 1;
}

button::after {
  border: none;
}

.shell {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

.page-scroll {
  position: relative;
  z-index: 2;
  min-height: 100vh;
}

.bg-layer {
  position: absolute;
  inset: 0;
  overflow: hidden;
}

.bg-orb {
  position: absolute;
  border-radius: 999rpx;
  filter: blur(24rpx);
}

.bg-orb.sky {
  width: 360rpx;
  height: 360rpx;
  top: 80rpx;
  right: -120rpx;
  background: rgba(83, 224, 255, 0.12);
}

.bg-orb.blue {
  width: 300rpx;
  height: 300rpx;
  top: 520rpx;
  left: -100rpx;
  background: rgba(144, 167, 255, 0.12);
}

.bg-orb.emerald {
  width: 220rpx;
  height: 220rpx;
  bottom: 180rpx;
  right: 80rpx;
  background: rgba(124, 245, 209, 0.08);
}

.page-inner {
  position: relative;
  z-index: 2;
  padding: 36rpx 28rpx 56rpx;
}

.glass-card {
  position: relative;
  overflow: hidden;
  border: 1rpx solid var(--stroke);
  border-radius: 32rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.02), rgba(255, 255, 255, 0)),
    var(--card);
  box-shadow:
    0 20rpx 60rpx rgba(0, 0, 0, 0.24),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
}

.glass-card + .glass-card {
  margin-top: 24rpx;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(83, 224, 255, 0.12);
  color: var(--sky-soft);
  font-size: 22rpx;
  letter-spacing: 1.2rpx;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.section-title {
  margin-top: 10rpx;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.section-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-soft);
}

.status-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.06);
  color: var(--text-soft);
  font-size: 22rpx;
}

.status-pill.sky {
  background: rgba(83, 224, 255, 0.16);
  color: var(--sky-soft);
}

.status-pill.emerald {
  background: rgba(124, 245, 209, 0.14);
  color: var(--emerald);
}

.status-pill.amber {
  background: rgba(247, 198, 107, 0.16);
  color: var(--amber);
}

.status-pill.rose {
  background: rgba(255, 138, 138, 0.16);
  color: var(--rose);
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, var(--sky) 0%, #7cb9ff 100%);
  color: #05131f;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 18rpx 36rpx rgba(83, 224, 255, 0.22);
}

.primary-button.disabled {
  opacity: 0.5;
}

.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(83, 224, 255, 0.2);
  background: rgba(83, 224, 255, 0.06);
  color: var(--sky-soft);
  font-size: 28rpx;
  font-weight: 600;
}

.field-label {
  margin-bottom: 14rpx;
  font-size: 24rpx;
  color: var(--text-soft);
}

.field-input {
  height: 84rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(156, 214, 255, 0.12);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.04);
  color: var(--text-main);
  font-size: 30rpx;
}

.soft-caption {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-dim);
}
